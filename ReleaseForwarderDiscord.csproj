<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- NetCord 1.0.0-beta.16 targets net10.0 only -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ReleaseForwarderDiscord</AssemblyName>

    <!-- Native AOT -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single package: REST client lives in the core NetCord package -->
    <PackageReference Include="NetCord" Version="1.0.0-beta.16" />
  </ItemGroup>

</Project>
